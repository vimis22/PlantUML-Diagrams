@startuml
title Job Pipeline State Machine
hide empty description

' Data Context / Attributes
note as N1
  <b>Job Context Attributes:</b>
  * BookId: Guid
  * PrintingStatus: Queued | Done
  * CoverStatus: Queued | Done
  * BindingStatus: Queued | Done
end note

[*] --> Pending : Job Created

state "Parallel Production Phase" as Phase1 {
    state "Split Processing" as f1 <<fork>>
    state "Sync Processing" as j1 <<join>>

    [*] --> f1

    f1 --> PrintingStage
    f1 --> CoverStage

    state PrintingStage {
        [*] --> P_Queued : Status = queued
        P_Queued --> P_Running : Machine Assigned
        P_Running --> P_Done : MQTT 'done'
    }

    state CoverStage {
        [*] --> C_Queued : Status = queued
        C_Queued --> C_Running : Machine Assigned
        C_Running --> C_Done : MQTT 'done'
    }

    P_Done --> j1
    C_Done --> j1
}

j1 --> BindingStage : Both Stages 'done'

state BindingStage {
    [*] --> B_Queued : Status = queued
    B_Queued --> B_Running : Binder Assigned
    B_Running --> B_Done : MQTT 'done'
}

BindingStage --> PackagingStage

state PackagingStage {
    [*] --> Pac_Queued : Status = queued
    Pac_Queued --> Pac_Running : Packager Assigned
    Pac_Running --> Pac_Done : MQTT 'done'
}

PackagingStage --> [*] : Job Complete
@enduml
