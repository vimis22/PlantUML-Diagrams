@startuml BookScheduler_IBD
title Internal Block Diagram - BookScheduler_MQTT Module

left to right direction

skinparam component {
  BackgroundColor LightSteelBlue
  BorderColor Black
  FontSize 11
}

skinparam interface {
  BackgroundColor LightYellow
  BorderColor Black
}

package "BookScheduler_MQTT" <<component>> as BookScheduler {

  component "Program\n(Entry Point)" <<block>> as Program
  component "MachineManager\n(Orchestration)" <<block>> as MachineManager
  component "BaseMachine\n(Abstract Base)" <<block>> as BaseMachine
  component "Printer" <<block>> as Printer
  component "Cover" <<block>> as Cover
  component "Binder" <<block>> as Binder
  component "Packager" <<block>> as Packager
  component "DbHelper\n(Data Access)" <<block>> as DbHelper
  component "MqttClientService\n(Messaging)" <<block>> as MqttClientService

  ' Relationships within module
  Program ..> DbHelper         : creates
  Program ..> MqttClientService: creates
  Program ..> MachineManager   : creates

  Program ..> Printer  : creates (local sim)
  Program ..> Cover    : creates (local sim)
  Program ..> Binder   : creates (local sim)
  Program ..> Packager : creates (local sim)

  MachineManager ..> MqttClientService : uses (subscribe/publish)
  MachineManager ..> DbHelper          : uses (queries/updates)
  MachineManager ..> BaseMachine       : coordinates via MQTT (assigns jobs)

  BaseMachine ..> MqttClientService : uses (heartbeat/progress)
  BaseMachine ..> DbHelper          : uses (status/progress)

  Printer  --|> BaseMachine : extends
  Cover    --|> BaseMachine : extends
  Binder   --|> BaseMachine : extends
  Packager --|> BaseMachine : extends
}

cloud "MQTT Broker\n(Mosquitto)" as MQTT
database "PostgreSQL\n(bookscheduler)" as DB

MqttClientService ..> MQTT : connects
DbHelper ..> DB : queries

legend right
  Connection Types
  ..>  : dependency (creates/uses/coordinates/connects/queries)
  --|> : inheritance (extends)

  Component Types
  <<component>> : main module boundary
  <<block>>     : internal component/package
endlegend

@enduml

